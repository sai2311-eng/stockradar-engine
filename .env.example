# Copy this file to .env and fill in values for whatever you wire up.
# The open engine needs none of these to run with the NullDataFeed.

# How often the runner ticks, in seconds.
TICK_INTERVAL_SEC=60

# Logging verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Comma-separated symbols exposed to strategies via ctx.universe
# e.g. UNIVERSE=AAPL,MSFT,NIFTY
UNIVERSE=

# ── Add your own below ───────────────────────────────────────────────────
# Whatever your DataFeed / execution layer needs — broker keys, DB URLs, etc.
# Keep real secrets in .env only (never commit it; see .gitignore).
# BROKER_API_KEY=
# BROKER_API_SECRET=
# DATABASE_URL=
